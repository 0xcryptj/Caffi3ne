# Public site URL for this environment. Production MUST be your live domain (e.g. https://caffi3ne.cc):
# signup confirmation and magic links use this so emails never point at localhost by mistake.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer publishable key (Supabase dashboard → API). Legacy anon key still works as fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase → Authentication → URL configuration:
# - Site URL: your public home URL for that environment (e.g. https://caffi3ne.cc).
# - Redirect URLs (allowlist every origin users sign in from). Google uses a small popup and
#   `?popup=1` on the callback — use a wildcard so both work, e.g.:
#   http://localhost:3000/auth/callback**
#   https://caffi3ne.cc/auth/callback**
#   https://<your-worker>.<subdomain>.workers.dev/auth/callback**
# Password reset emails use PKCE: allowlist the recovery handler (Supabase appends ?code=):
#   http://localhost:3000/auth/confirm-recovery**
#   https://caffi3ne.cc/auth/confirm-recovery**
# Email + password: Authentication → Providers → Email → enable “Email”. Confirm signup can stay on for production.
# After signup, users complete onboarding at /onboarding. Run SQL in `supabase/profiles-schema.sql` (profiles table, RLS, trigger).
# Email (magic link): enable Email provider; template links must use the redirect URL above.
# ── Google sign-in (two different URLs — do not mix them up) ─────────────────────
# The error "provider is not enabled" means Supabase → Providers → Google is OFF or not saved.
# You must enable Google there AND paste Client ID + Client secret from Google Cloud.
#
# (1) GOOGLE CLOUD CONSOLE → APIs & Services → Credentials → your OAuth 2.0 Web client
#     → Authorized redirect URIs → add ONLY Supabase’s callback (NOT localhost):
#       https://<project-ref>.supabase.co/auth/v1/callback
#     Google sends the user back to Supabase first; Supabase then sends them to your app.
#
# (2) SUPABASE DASHBOARD → Authentication → URL configuration → Redirect URLs
#     → add where YOUR app lives (wildcard `**` covers `/auth/callback?popup=1` for windowed Google):
#       http://localhost:3000/auth/callback**
#       https://your-production-domain/auth/callback**
#
# (3) SUPABASE DASHBOARD → Authentication → Providers → Google
#     → Enable, paste Client ID + Client secret, Save.
#
# Option B — CLI: npm run enable-google-auth (needs SUPABASE_ACCESS_TOKEN + Google id/secret).
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Cloudflare Workers: set the same NEXT_PUBLIC_* vars in the Workers/Pages project settings.
#
# ── Cloudflare edge hardening (recommended in the CF dashboard) ─────────────────
# - Proxy DNS (orange cloud) so traffic hits Cloudflare before your origin / Worker.
# - Security → Bots: enable Bot Fight Mode or Super Bot Fight Mode; add WAF rules for /api/* if needed.
# - Optional: Turnstile on login/signup for additional bot friction (not wired in this repo by default).
#
# When your production hostname is ONLY reachable through Cloudflare, you may set:
#   REQUIRE_CLOUDFLARE_PROXY=true
# so /api/* returns 404 unless the request includes a cf-ray header (absent on localhost and direct-origin hits).
# Keep false for local dev, preview URLs without CF, or uptime checks that bypass Cloudflare.
REQUIRE_CLOUDFLARE_PROXY=false
#
# Email branding (magic link / signup — replaces “Supabase” copy in user inboxes):
# Dashboard → Authentication → Email Templates → edit “Confirm signup”, “Magic link”, etc.
# Use your product name (e.g. Caffi3ne) in subject and body; keep {{ .ConfirmationURL }}.
# Optional: Authentication → SMTP Settings → custom SMTP + “From” name for fully branded sender
# (otherwise the “from” address stays Supabase’s; body/subject are still yours).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GOOGLE_API_KEY=your-google-cloud-api-key
TOMORROW_IO_API_KEY=your-tomorrow-io-api-key
TOMTOM_API_KEY=your-tomtom-api-key
# Third-party keys for data pipelines (do not expose names or keys in the product UI)
BESTTIME_API_KEY=your-besttime-api-key

# Default: live data (omit or set false). Only set true for rare local debugging.
USE_MOCK_DATA=false
MOCK_BILLING_ENABLED=false

TOMTOM_API_KEY_SECONDARY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
BESTTIME_API_PRIVATE_KEY=
BESTTIME_API_PUBLIC_KEY=
